# =====================================================================
# VANSHU'S LITTLE WORLD - ENVIRONMENT VARIABLES
# =====================================================================
# To connect Supabase for cloud database, authentication, and photo storage:
# 1. Create a free project at https://supabase.com
# 2. Copy your Project URL & Anon Key from Settings > API
# 3. Rename this file to .env and paste your values below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
